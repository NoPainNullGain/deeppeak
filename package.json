{
  "name": "deeppeak",
  "displayName": "DeepPeak",
  "description": "A lightweight VS Code widget for DeepSeek API balance and peak pricing.",
  "version": "0.0.3",
  "publisher": "NoPainNullGain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoPainNullGain/deeppeak.git"
  },
  "bugs": {
    "url": "https://github.com/NoPainNullGain/deeppeak/issues"
  },
  "homepage": "https://github.com/NoPainNullGain/deeppeak#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deeppeak.setApiKey",
        "title": "DeepPeak: Set DeepSeek API Key"
      },
      {
        "command": "deeppeak.refresh",
        "title": "DeepPeak: Refresh Balance"
      },
      {
        "command": "deeppeak.openSettings",
        "title": "DeepPeak: Open Settings"
      }
    ],
    "configuration": {
      "title": "DeepPeak",
      "properties": {
        "deeppeak.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "description": "How often to refresh the DeepSeek balance in seconds. The minimum is 30 seconds."
        },
        "deeppeak.model": {
          "type": "string",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro",
            "deepseek-v4-flash-vision-exp"
          ],
          "enumDescriptions": [
            "DeepSeek V4 Flash",
            "DeepSeek V4 Pro",
            "DeepSeek V4 Flash Vision Experimental"
          ],
          "default": "deepseek-v4-flash",
          "description": "The DeepSeek model whose pricing should be shown. This does not change the model used by other clients."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && vsce package",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.7.2"
  }
}
